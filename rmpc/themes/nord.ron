#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    draw_borders: false,
    show_song_table_header: false,
    symbols: (song: "♪", dir: "▸", playlist: "♫", marker: "\u{e0b0}"),
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Pane(Header),
                size: "1",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                pane: Pane(ProgressBar),
                size: "1",
            ),
        ],
    ),
    progress_bar: (
        symbols: ["█", "█", "●", " ", " "],
        track_style: (bg: "#3b4252"),
        elapsed_style: (fg: "#88c0d0", bg: "#3b4252"),
        thumb_style: (fg: "#81a1c1", bg: "#3b4252"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (),
        ends_style: (),
        thumb_style: (fg: "#81a1c1"),
    ),
    browser_column_widths: [20, 38, 42],
    text_color: "#e5e9f0",
    background_color: "#2e3440",
    header_background_color: "#2e3440",
    modal_background_color: None,
    modal_backdrop: false,
    tab_bar: (active_style: (fg: "#2e3440", bg: "#88c0d0", modifiers: "Bold"), inactive_style: ()),
    borders_style: (fg: "#434c5e"),
    highlighted_item_style: (fg: "#88c0d0", modifiers: "Bold"),
    current_item_style: (fg: "#2e3440", bg: "#5e81ac", modifiers: "Bold"),
    highlight_border_style: (fg: "#5e81ac"),
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "#81a1c1"), default: (kind: Text("Unknown"))),
            width: "50%",
            alignment: Right,
        ),
        (
            prop: (kind: Text("-"), style: (fg: "#4c566a"), default: (kind: Text("Unknown"))),
            width: "1",
            alignment: Center,
        ),
        (
            prop: (kind: Property(Title), style: (fg: "#a3be8c"), default: (kind: Text("Unknown"))),
            width: "50%",
        ),
    ],
    header: (
        rows: [
            (
                left: [
                    (kind: Property(Status(StateV2(
                        playing_label: "▶",
                        paused_label: "▮▮",
                        stopped_label: "■",
                        playing_style: (fg: "#a3be8c"),
                        paused_style: (fg: "#ebcb8b"),
                        stopped_style: (fg: "#bf616a"),
                    ))), style: (fg: "#81a1c1", modifiers: "Bold")),
                    (kind: Text("  ")),
                    (kind: Property(Status(RepeatV2(
                        on_label: "r",
                        off_label: "r",
                        on_style: (fg: "#88c0d0", modifiers: "Bold"),
                        off_style: (fg: "#434c5e"),
                    )))),
                    (kind: Text(" ")),
                    (kind: Property(Status(RandomV2(
                        on_label: "z",
                        off_label: "z",
                        on_style: (fg: "#88c0d0", modifiers: "Bold"),
                        off_style: (fg: "#434c5e"),
                    )))),
                    (kind: Text(" ")),
                    (kind: Property(Status(ConsumeV2(
                        on_label: "c",
                        off_label: "c",
                        on_style: (fg: "#bf616a", modifiers: "Bold"),
                        off_style: (fg: "#434c5e"),
                    )))),
                    (kind: Text(" ")),
                    (kind: Property(Status(SingleV2(
                        on_label: "s",
                        off_label: "s",
                        on_style: (fg: "#d08770", modifiers: "Bold"),
                        off_style: (fg: "#434c5e"),
                    )))),
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#88c0d0", modifiers: "Bold"),
                        default: (kind: Text("Unknown"), style: (fg: "#88c0d0", modifiers: "Bold"))
                    ),
                    (kind: Text(" - ")),
                    (kind: Property(Song(Title)), style: (fg: "#a3be8c", modifiers: "Bold"),
                        default: (kind: Text("No Song"), style: (fg: "#a3be8c", modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Text("Vol: "), style: (fg: "#81a1c1", modifiers: "Bold")),
                    (kind: Property(Status(Volume)), style: (fg: "#81a1c1", modifiers: "Bold")),
                    (kind: Text("% "), style: (fg: "#81a1c1", modifiers: "Bold"))
                ]
            )
        ],
    ),
)
